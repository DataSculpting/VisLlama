{
  "exe": "C:/Maya/build/maya.exe",
  "args": [
    "--glm-pack",
    "D:/Maya-data/models/Maya-S/pack",
    "--max-context",
    "32768",
    "--expert-cache",
    "auto",
    "--prefill",
    "auto",
    "--kv-streaming",
    "on",
    "--expert-profile",
    "C:/Maya/data/glm-expert-profile.bin",
    "--kv-resident",
    "8192",
